# Copy to .env and fill in. Validated at startup (P0-I5).

# --- Runtime ---
# development | test | production. Production refuses the example secrets below.
# NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (default: info; debug in development).
# LOG_LEVEL=info

# --- Local services (docker/compose.dev.yml) ---
POSTGRES_PORT=5440
VALKEY_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL=postgresql://socioboard:socioboard@localhost:5440/socioboard
# Connections per process (api and worker each have their own pool).
# DATABASE_POOL_SIZE=10
# Valkey or Redis; any Redis-compatible URL works.
REDIS_URL=redis://localhost:6380
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Socioboard <no-reply@socioboard.local>"

# --- Media storage ---
# Default: Amazon S3. Fill in your dev bucket and an access key scoped to it.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS S3; set for MinIO or another S3-compatible service.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# No S3 account? Use local MinIO instead: uncomment these lines (they
# override the block above) and run `pnpm services:up` again.
# COMPOSE_PROFILES=minio
# S3_BUCKET=socioboard-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=socioboard
# S3_SECRET_ACCESS_KEY=socioboard-dev-secret
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- Media delivery to networks ---
# Networks that can't take an upload (Instagram images; TikTok later) fetch files from here.
# Production: https://media.<domain> (proxied to the API's /public-media). Locally: your dev
# tunnel, e.g. https://dev1.dev.socioboard.com/public-media. Unset: those posts fail with a
# clear message; Facebook and Instagram videos still work (they are uploaded directly).
MEDIA_PUBLIC_URL=
# Development shortcut: if your bucket is publicly readable through a CDN, networks can fetch
# <STORAGE_PUBLIC_URL>/<key> directly (no tunnel). MEDIA_PUBLIC_URL wins when both are set.
# STORAGE_PUBLIC_URL=

# --- Media processing ---
# ffmpeg/ffprobe for video duration and thumbnails (on PATH by default). Without them, videos
# are still usable, just without duration and thumbnail. Windows: winget install ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Audit log ---
# Days to keep audit entries (default 730 = 2 years).
AUDIT_RETENTION_DAYS=730

# --- Apps ---
API_PORT=3000
# Proxies whose X-Forwarded-For is believed: "loopback" (dev, the Vite proxy) or comma-separated
# IPs/CIDR ranges of your load balancer or Caddy. Required in production: every rate limit keys on it.
TRUST_PROXY=loopback
API_RATE_LIMIT_PER_MIN=300
APP_URL=http://localhost:5173

# --- Secrets ---
# Token encryption: comma-separated id:base64 32-byte keys; the first one encrypts.
# Generate: node -e "console.log(\"k1:\" + require(\"crypto\").randomBytes(32).toString(\"base64\"))"
# The key below is for local development only and is refused in production.
ENCRYPTION_KEYS=k1:ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

# --- Auth ---
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The value below is for local development only and is refused in production.
AUTH_SECRET=dev-only-auth-secret-do-not-use-in-production
# Check new passwords against Have I Been Pwned (range API; the password never leaves the server).
# Set to false for installs without internet access.
AUTH_BREACHED_PASSWORD_CHECK=true
# Optional social sign-in; each registers only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Social networks (docs/developer-apps.md) ---
# Each login is on only when its id and secret are set; networks without one stay hidden.
# Facebook Login for Business: Facebook Pages and the Instagram accounts linked to them.
# Redirect URI to add in the Meta app: <APP_URL>/api/oauth/facebook/callback
META_APP_ID=
META_APP_SECRET=
# Login for Business configuration id (User access token); without it the permissions are sent as scope.
META_LOGIN_CONFIG_ID=
# Instagram Login (Instagram professional accounts without a Page); needs an https APP_URL.
# Redirect URI: <APP_URL>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Graph API version; leave empty for the one the adapters were checked against.
META_GRAPH_VERSION=

# --- Development seed (pnpm db:seed) ---
# Password for the seeded demo users (<role>@socioboard.test). Never used in production.
SEED_PASSWORD=socioboard-dev-password

# --- Optional features (off while unset) ---
# Billing (Stripe), phase 5.
# STRIPE_SECRET_KEY=
# AI service (socioboard/socioboard-ai), phase 4.
# AI_SERVICE_URL=
