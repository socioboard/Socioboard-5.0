# Copy to .env and fill in. Validated at startup (P0-I5).

# --- Local services (docker/compose.dev.yml) ---
POSTGRES_PORT=5440
VALKEY_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL=postgresql://socioboard:socioboard@localhost:5440/socioboard
# Valkey or Redis; any Redis-compatible URL works.
REDIS_URL=redis://localhost:6380
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Socioboard <no-reply@socioboard.local>"

# --- Media storage (Amazon S3, dev bucket) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services other than AWS; leave empty for AWS S3.
S3_ENDPOINT=

# --- Apps ---
API_PORT=3000
APP_URL=http://localhost:5173
