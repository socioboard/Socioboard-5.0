// Socioboard 6.0 database schema. Each phase adds its tables (docs/traceability.md).
//
// Conventions
// - Ids are UUIDv7 (time-ordered). Better Auth passes its own (configured to UUIDv7, P0-B2);
//   our tables default to uuid(7).
// - Workspace-owned tables have `workspaceId` and are listed in WORKSPACE_SCOPED_MODELS
//   (src/scoped-models.ts), so `db.forWorkspace(id)` limits every query to one workspace.
// - A link between two workspace-owned tables is a composite foreign key
//   (xId, workspaceId) -> (id, workspaceId), so Postgres itself rejects a link across
//   workspaces. Those links use onDelete: NoAction: deleting a parent that still has children
//   fails (the service moves or clears them first; SET NULL would also null workspaceId), while
//   deleting a whole workspace still cascades, because NO ACTION is checked at statement end.
// - Models named user, session, account, verification, workspace, member, invitation and
//   twoFactor are read and written by Better Auth: keep their field names as they are.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core + two-factor plugin) — docs/backend/modules/auth.md
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  /// Avatar URL from a social login (Google/Microsoft). Uploaded avatars use avatarKey.
  image            String?
  /// Storage key of an uploaded avatar; wins over `image` when set.
  avatarKey        String?
  timezone         String?
  locale           String   @default("en")
  isPlatformAdmin  Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  memberships       Member[]
  invitationsSent   Invitation[]
  mediaUploaded     MediaAsset[]
  connectionsAdded  SocialConnection[]       @relation("ConnectionsAdded")
  accountsAdded     SocialAccount[]          @relation("AccountsAdded")
  oauthStates       OAuthState[]
  posts             Post[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  flagsUpdated      FeatureFlag[]
}

model Session {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @db.Uuid
  token             String   @unique
  expiresAt         DateTime
  ipAddress         String?
  userAgent         String?
  /// Workspace the user last switched to; not a foreign key, checked against membership on use.
  activeWorkspaceId String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Login identities (password, Google, Microsoft). Social accounts for posting are SocialConnection (P1).
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for providerId "credential".
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Email verification, password reset and magic-link tokens.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

// ---------------------------------------------------------------------------
// Workspaces (Better Auth organization plugin: organization = workspace)
// docs/backend/modules/workspaces.md
// ---------------------------------------------------------------------------

model Workspace {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  slug                String    @unique
  /// Storage key of the uploaded logo.
  logo                String?
  metadata            String?
  timezone            String
  requireReviewForAll Boolean   @default(false)
  createdAt           DateTime  @default(now())
  /// Soft delete; rows are removed 30 days later with everything they own.
  deletedAt           DateTime?

  members           Member[]
  invitations       Invitation[]
  mediaAssets       MediaAsset[]
  mediaFolders      MediaFolder[]
  socialConnections SocialConnection[]
  socialAccounts    SocialAccount[]
  accountGroups     SocialAccountGroup[]
  accountGroupItems SocialAccountGroupItem[]
  oauthStates       OAuthState[]
  posts             Post[]
  postTargets       PostTarget[]
  publishAttempts   PublishAttempt[]
  postLabels        PostLabel[]
  recurringRules    RecurringRule[]
  queueSlots        QueueSlot[]
  notifications     Notification[]
}

model Member {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  /// owner | admin | editor | contributor | viewer (see @socioboard/contracts permissions)
  role        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  email       String
  role        String?
  /// Better Auth values: pending | accepted | rejected | canceled; expiry is read from expiresAt.
  status      String   @default("pending")
  expiresAt   DateTime
  inviterId   String   @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Media — docs/backend/modules/media.md
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video
  gif
}

enum MediaSource {
  upload
  ai
  discovery
}

enum MediaStatus {
  uploading
  processing
  ready
  failed
}

model MediaFolder {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]

  @@unique([id, workspaceId])
  @@index([workspaceId, parentId])
}

model MediaAsset {
  id           String      @id @default(uuid(7)) @db.Uuid
  workspaceId  String      @db.Uuid
  /// Display name (starts as the uploaded file name).
  name         String
  folderId     String?     @db.Uuid
  kind         MediaKind
  mime         String
  storageKey   String      @unique
  /// Up to 1 GB by default; Int holds up to 2 GB.
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  thumbnailKey String?
  source       MediaSource @default(upload)
  /// Set when source = ai; foreign key added with AiJob (P4-B1).
  aiJobId      String?     @db.Uuid
  altText      String?
  status       MediaStatus @default(uploading)
  /// S3 multipart upload id while status = uploading.
  uploadId     String?
  uploadedById String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  /// Soft delete; the storage objects are purged a week later.
  deletedAt    DateTime?

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder     MediaFolder? @relation(fields: [folderId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  uploadedBy User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, folderId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Social accounts — docs/backend/modules/social-accounts.md
// A SocialConnection is one login (OAuth tokens); a SocialAccount is one asset reached through
// it (a Page, an Instagram account…). Values match LoginProvider and NetworkId in the contracts.
// ---------------------------------------------------------------------------

enum LoginProvider {
  facebook
  instagram
  linkedin
  x
  youtube
  pinterest
  tiktok
  snapchat
  tumblr
}

enum SocialNetwork {
  facebook_page
  instagram
  linkedin_person
  linkedin_org
  x
  youtube
  pinterest
  tiktok
  snapchat
  tumblr
}

enum ConnectionStatus {
  active
  reauth_required
  revoked
}

enum AccountStatus {
  active
  reauth_required
  disconnected
  paused
}

model SocialConnection {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @db.Uuid
  provider        LoginProvider
  /// The login's id on the network (e.g. the Facebook user id); detects the same login twice.
  externalUserId  String
  displayName     String
  avatarUrl       String?
  /// Encrypted with platform/crypto (AES-256-GCM); never logged or sent to the browser.
  accessTokenEnc  String
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  scopes          String[]
  status          ConnectionStatus @default(active)
  /// Why it needs attention, in the network's words.
  statusReason    String?
  connectedById   String?          @db.Uuid
  lastCheckedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?           @relation("ConnectionsAdded", fields: [connectedById], references: [id], onDelete: SetNull)
  accounts    SocialAccount[]
  oauthStates OAuthState[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, provider, externalUserId])
}

model SocialAccount {
  id                  String        @id @default(uuid(7)) @db.Uuid
  workspaceId         String        @db.Uuid
  /// Null once its login is removed; the account is then disconnected and kept for post history.
  connectionId        String?       @db.Uuid
  network             SocialNetwork
  externalId          String
  displayName         String
  username            String?
  avatarUrl           String?
  /// Per-asset token where the network issues one (Facebook Page tokens); else the login's is used.
  assetTokenEnc       String?
  assetTokenExpiresAt DateTime?
  /// Network extras: Instagram's linked Page, Pinterest default board, LinkedIn org URN…
  meta                Json          @default("{}")
  status              AccountStatus @default(active)
  statusReason        String?
  connectedById       String?       @db.Uuid
  lastCheckedAt       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection  SocialConnection?        @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  connectedBy User?                    @relation("AccountsAdded", fields: [connectedById], references: [id], onDelete: SetNull)
  groupItems  SocialAccountGroupItem[]
  postTargets PostTarget[]
  queueSlots  QueueSlot[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, network, externalId])
  @@index([connectionId])
}

/// Saved sets of accounts, e.g. "Brand A all channels" (routes arrive with P3-F3).
model SocialAccountGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     SocialAccountGroupItem[]

  @@unique([id, workspaceId])
}

model SocialAccountGroupItem {
  id              String @id @default(uuid(7)) @db.Uuid
  workspaceId     String @db.Uuid
  groupId         String @db.Uuid
  socialAccountId String @db.Uuid

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group     SocialAccountGroup @relation(fields: [groupId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  account   SocialAccount      @relation(fields: [socialAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([groupId, socialAccountId])
  @@index([socialAccountId])
}

/// One OAuth attempt: single use, expires after 10 minutes.
model OAuthState {
  id                    String        @id @default(uuid(7)) @db.Uuid
  /// Random value sent to the network and checked on the callback.
  state                 String        @unique
  workspaceId           String        @db.Uuid
  userId                String        @db.Uuid
  provider              LoginProvider
  pkceVerifier          String?
  /// Set when reconnecting: the callback must return the same login.
  connectionId          String?       @db.Uuid
  forceAccountSelection Boolean       @default(false)
  expiresAt             DateTime
  createdAt             DateTime      @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection SocialConnection? @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Posts and publishing — docs/backend/modules/posts.md, publishing.md
// A Post holds the shared content; each PostTarget is its delivery to one account.
// ---------------------------------------------------------------------------

enum PostStatus {
  draft
  in_review
  approved
  scheduled
  publishing
  published
  partial
  failed
}

enum TargetStatus {
  pending
  scheduled
  publishing
  published
  failed
  cancelled
}

enum PublishOutcome {
  running
  published
  failed
  will_retry
}

enum PublishErrorKind {
  retryable
  rate_limited
  auth
  content
}

model Post {
  id              String     @id @default(uuid(7)) @db.Uuid
  workspaceId     String     @db.Uuid
  authorId        String?    @db.Uuid
  /// Derived from the targets by the posts service (recomputeStatus).
  status          PostStatus @default(draft)
  text            String     @default("")
  /// MediaAsset ids in display order. No foreign key: checked by the service; a media delete
  /// looks here before removing a file a scheduled post uses.
  mediaIds        String[]   @db.Uuid
  link            String?
  firstComment    String?
  /// PostLabel ids (P1-B11).
  labelIds        String[]   @db.Uuid
  /// Set on a recurring rule's occurrence posts (P2-B4): the rule that made it, and the occurrence
  /// it is for. No foreign key: a rule is deactivated, not deleted, so sent occurrences keep the
  /// link; and a composite key couldn't clear this one column (it would null workspaceId too).
  recurringRuleId String?    @db.Uuid
  occurrenceAt    DateTime?
  /// An occurrence edited or moved on its own: changing the rule or the template no longer
  /// replaces it.
  customizedAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  targets       PostTarget[]
  recurringRule RecurringRule?

  @@unique([id, workspaceId])
  /// Each occurrence is created once, however often the expansion job runs.
  @@unique([recurringRuleId, occurrenceAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([mediaIds], type: Gin)
  @@index([labelIds], type: Gin)
}

model PostTarget {
  id              String       @id @default(uuid(7)) @db.Uuid
  workspaceId     String       @db.Uuid
  postId          String       @db.Uuid
  socialAccountId String       @db.Uuid
  /// TargetOverride from the contracts: text, mediaIds and network options for this account.
  override        Json?
  scheduledAt     DateTime?
  /// Bumped on every reschedule; a publish job for an older version exits (P2).
  scheduleVersion Int          @default(0)
  status          TargetStatus @default(pending)
  externalPostId  String?
  permalink       String?
  attempts        Int          @default(0)
  /// PublishError from the contracts: kind, networkCode, message.
  lastError       Json?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post             @relation(fields: [postId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  account   SocialAccount    @relation(fields: [socialAccountId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  history   PublishAttempt[]

  @@unique([id, workspaceId])
  @@unique([postId, socialAccountId])
  @@index([socialAccountId, status])
  @@index([status, scheduledAt])
}

enum LabelColor {
  gray
  red
  orange
  amber
  green
  teal
  blue
  indigo
  violet
  pink
}

/// The workspace's post labels (P1-B11). Posts keep label ids in Post.labelIds (no foreign key);
/// deleting a label removes its id from those posts in the same transaction.
model PostLabel {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @db.Uuid
  name        String
  color       LabelColor
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Every try at publishing a target, shown as its history.
model PublishAttempt {
  id           String            @id @default(uuid(7)) @db.Uuid
  workspaceId  String            @db.Uuid
  postTargetId String            @db.Uuid
  attemptNo    Int
  startedAt    DateTime          @default(now())
  /// Set just before the network is called: a try still `running` with it set may be on the
  /// network already (its worker died mid-call), so it is never sent blindly again.
  sentAt       DateTime?
  finishedAt   DateTime?
  outcome      PublishOutcome    @default(running)
  errorKind    PublishErrorKind?
  networkCode  String?
  message      String?
  /// Network charges for this attempt (X bills per post), in the network's units.
  costUnits    Float?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target    PostTarget @relation(fields: [postTargetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([postTargetId, attemptNo])
}

// ---------------------------------------------------------------------------
// Audit — docs/backend/modules/audit.md
// ---------------------------------------------------------------------------

enum AuditActorType {
  user
  admin
  system
}

/// Append-only. No foreign keys, so entries outlive the users and workspaces they mention.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events (e.g. an admin action outside any workspace).
  workspaceId String?        @db.Uuid
  actorUserId String?        @db.Uuid
  actorType   AuditActorType
  /// e.g. "member.role_changed"
  action      String
  entityType  String
  entityId    String?
  diff        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
}

// ── Phase 2: scheduling, notifications, feature flags ─────────────────────────────────────────

/// How a post repeats (docs/backend/modules/scheduling.md). `postId` is the template post: it holds
/// the content and is never published itself; the `recurring` job creates an ordinary post per
/// occurrence (Post.recurringRuleId + occurrenceAt). Stopping a rule deactivates it.
model RecurringRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  postId      String    @db.Uuid
  /// RecurrenceRule from the contracts, as the API took it (and returns it).
  rule        Json
  /// RFC 5545 RRULE built from `rule`, read by the expansion job.
  rrule       String
  /// IANA timezone the rule's wall-clock time is in.
  timezone    String
  /// First and last possible occurrence (UTC); endsAt null = no end date.
  startsAt    DateTime
  endsAt      DateTime?
  /// The next occurrence not yet created; null once the rule has ended.
  nextRunAt   DateTime?
  active      Boolean   @default(true)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  /// One rule per template post (post ids are unique; the pair is what the relation needs).
  @@unique([postId, workspaceId])
  @@index([active, nextRunAt])
}

/// An account's preferred posting time, for "Add to queue" (P2-B3).
model QueueSlot {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  socialAccountId String   @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday         Int      @db.SmallInt
  /// HH:mm, wall-clock in `timezone`.
  time            String
  timezone        String
  createdAt       DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   SocialAccount @relation(fields: [socialAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@unique([socialAccountId, weekday, time])
}

/// A user's notification (docs/backend/modules/notifications.md), across workspaces. Kept 90 days.
/// Read through the user, never through a workspace-scoped client: workspaceId only says where
/// it came from (null: about the user alone).
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String?   @db.Uuid
  /// NotificationType from the contracts (a string, so new types need no migration).
  type        String
  /// English fallback; the UI words it from type + params.
  title       String
  body        String
  /// A path inside the app (AppPath in the contracts).
  link        String?
  params      Json      @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
}

/// A user's choice for one notification type; types with no row use their defaults.
model NotificationPreference {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  type      String
  inApp     Boolean
  email     Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Platform feature flags, read through `flags.isOn(key, ctx)` (platform/flags, P2-B11).
model FeatureFlag {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// e.g. "network.tiktok"
  key         String   @unique
  description String   @default("")
  enabled     Boolean  @default(false)
  /// Who it's on for when enabled: { workspaceIds?: string[], percent?: 0–100 }; {} = everyone.
  rules       Json     @default("{}")
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Files kept by the NAS storage driver (STORAGE_DRIVER=nas, platform/storage/nas.ts): what the
/// NAS's own API can't answer. It has no "file info" or "list a folder", so size and type come
/// from here, and deleting a folder deletes the keys found here. S3 needs none of this.
model StoredObject {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// The app's storage key, e.g. workspaces/<id>/media/<id>/original.jpg
  key         String   @unique
  /// Where the NAS keeps it, as its upload answered (read at <NAS_PUBLIC_URL><path>).
  path        String
  size        Int
  contentType String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
