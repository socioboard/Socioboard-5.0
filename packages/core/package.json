    "@socket.io/redis-emitter": "^5.1.0",
    "better-auth": "~1.7.5",
    "bullmq": "^6.3.8",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
